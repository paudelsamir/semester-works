@{
    ViewData["Title"] = "Lab 27 - Authentication & Authorization";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1 class="mb-4">Lab 27: Authentication & Authorization</h1>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Logged In!</strong> Welcome, <strong>@User.Identity.Name</strong>
                </div>

                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5>Your Access</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>User Email:</strong> @User.Identity.Name</p>
                        <p><strong>Roles:</strong> 
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            @if (User.IsInRole("Teacher"))
                            {
                                <span class="badge bg-info">Teacher</span>
                            }
                            @if (User.IsInRole("Student"))
                            {
                                <span class="badge bg-primary">Student</span>
                            }
                        </p>

                        <div class="mt-3">
                            <a href="/Home/Protected" class="btn btn-sm btn-info">View Protected Page</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Home/AdminOnly" class="btn btn-sm btn-danger">Admin Panel</a>
                            }
                            <form method="post" action="/Auth/Logout" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-warning">Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">You are not logged in. Please register or login to continue.</div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5>New User?</h5>
                            </div>
                            <div class="card-body text-center">
                                <p>Create a new account</p>
                                <a href="/Auth/Register" class="btn btn-primary btn-lg">Register</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5>Have Account?</h5>
                            </div>
                            <div class="card-body text-center">
                                <p>Sign in to your account</p>
                                <a href="/Auth/Login" class="btn btn-success btn-lg">Login</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-4 bg-light">
                    <div class="card-header">
                        <h5>Demo Credentials</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Admin</strong></td>
                                <td><code>admin@lab27.com</code></td>
                                <td><code>Admin@123</code></td>
                            </tr>
                            <tr>
                                <td><strong>Teacher</strong></td>
                                <td><code>teacher@lab27.com</code></td>
                                <td><code>Teacher@123</code></td>
                            </tr>
                            <tr>
                                <td><strong>Student</strong></td>
                                <td><code>student@lab27.com</code></td>
                                <td><code>Student@123</code></td>
                            </tr>
                        </table>
                    </div>
                </div>
            }

            <div class="card mt-4 bg-light">
                <div class="card-header">
                    <h5>How It Works</h5>
                </div>
                <div class="card-body">
                    <ul>
                        <li><strong>Authentication:</strong> Verify who you are (Login/Register)</li>
                        <li><strong>Authorization:</strong> Determine what you can access (Roles)</li>
                        <li><strong>Roles:</strong> Admin, Teacher, Student - different access levels</li>
                        <li><strong>Cookie-based:</strong> Session stored securely with expiration</li>
                        <li><strong>Password Hashing:</strong> Passwords hashed with ASP.NET Identity</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge { padding: 8px 12px; font-size: 0.9em; margin-right: 5px; }
    .card { box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px; }
    .container { max-width: 900px; }
</style>
