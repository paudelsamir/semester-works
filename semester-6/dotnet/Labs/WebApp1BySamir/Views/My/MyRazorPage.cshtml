@{
    ViewData["Title"] = "My Razor Page";
    var rollNo = 114;
    var tableNumber = rollNo / 79 + 1; // 114 / 79 = 1, so table of 2
    // Alternatively, if using last two digits: 79 + 1 = 80
    var myTableNumber = 80; // Based on roll no 114-079/D
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <!-- Current Date and Time -->
                    <div class="mb-4">
                        <h4 class="text-primary">Current Date and Time</h4>
                        <p class="lead">
                            <i class="fas fa-calendar-alt"></i> 
                            <strong>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</strong>
                        </p>
                        <p class="lead">
                            <i class="fas fa-clock"></i> 
                            <strong>@DateTime.Now.ToString("hh:mm:ss tt")</strong>
                        </p>
                    </div>

                    <hr />

                    <!-- Student Information -->
                    <div class="mb-4">
                        <h4 class="text-primary">Student Information</h4>
                        <p><strong>Name:</strong> Samir Paudel</p>
                        <p><strong>Roll No:</strong> 114-079/D</p>
                    </div>

                    <hr />

                    <!-- Multiplication Table -->
                    <div class="mb-4">
                        <h4 class="text-primary">Multiplication Table of @myTableNumber</h4>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Expression</th>
                                        <th>Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <tr>
                                            <td>@myTableNumber × @i</td>
                                            <td><strong>@(myTableNumber * i)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted">
                    Lab No.: 18 | Name: Samir Paudel | Roll No./Section: 114-079/D
                </div>
            </div>
        </div>
    </div>
</div>
