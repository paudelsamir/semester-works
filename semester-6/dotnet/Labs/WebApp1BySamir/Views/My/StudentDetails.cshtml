@model WebApp1BySamir.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h2 class="mb-0">
                        <i class="fas fa-user-graduate"></i> @ViewData["Title"]
                    </h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-success" role="alert">
                        <i class="fas fa-check-circle"></i> Student record created successfully!
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th class="bg-light" width="30%">
                                        @Html.DisplayNameFor(model => model.StdID)
                                    </th>
                                    <td>@Html.DisplayFor(model => model.StdID)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        @Html.DisplayNameFor(model => model.Name)
                                    </th>
                                    <td>@Html.DisplayFor(model => model.Name)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        @Html.DisplayNameFor(model => model.Address)
                                    </th>
                                    <td>@Html.DisplayFor(model => model.Address)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        @Html.DisplayNameFor(model => model.Faculty)
                                    </th>
                                    <td>
                                        <span class="badge bg-primary">
                                            @Html.DisplayFor(model => model.Faculty)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        @Html.DisplayNameFor(model => model.Email)
                                    </th>
                                    <td>
                                        <a href="mailto:@Model.Email">@Html.DisplayFor(model => model.Email)</a>
                                    </td>
                                </tr>
                                @if (Model.Phone != null)
                                {
                                    <tr>
                                        <th class="bg-light">
                                            @Html.DisplayNameFor(model => model.Phone)
                                        </th>
                                        <td>@Html.DisplayFor(model => model.Phone)</td>
                                    </tr>
                                }
                                @if (Model.Age != null)
                                {
                                    <tr>
                                        <th class="bg-light">
                                            @Html.DisplayNameFor(model => model.Age)
                                        </th>
                                        <td>@Html.DisplayFor(model => model.Age) years</td>
                                    </tr>
                                }
                                <tr>
                                    <th class="bg-light">Created On</th>
                                    <td>@DateTime.Now.ToString("MMMM dd, yyyy hh:mm:ss tt")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-action="CreateStudent" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create Another Student
                    </a>
                    <a asp-action="MyRazorPage" class="btn btn-secondary">
                        <i class="fas fa-home"></i> Go to My Razor Page
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
