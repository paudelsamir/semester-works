@{
    ViewData["Title"] = "Service Lifetimes";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0">
                        <i class="fas fa-layer-group"></i> Service Lifetimes Demonstration
                    </h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Note:</strong> Refresh this page multiple times to see how different service lifetimes behave!
                    </div>

                    <!-- Singleton Lifetime -->
                    <div class="mb-4">
                        <h4 class="text-success">
                            <i class="fas fa-cube"></i> Singleton Service
                        </h4>
                        <div class="card">
                            <div class="card-body bg-light">
                                <p><strong>DataService:</strong> @ViewBag.SingletonInfo</p>
                                <p class="mb-0 text-muted">
                                    <small>
                                        <i class="fas fa-check"></i> This timestamp remains the same across all requests because 
                                        Singleton services are created once and reused throughout the application lifetime.
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Scoped Lifetime -->
                    <div class="mb-4">
                        <h4 class="text-warning">
                            <i class="fas fa-layer-group"></i> Scoped Service
                        </h4>
                        <div class="card">
                            <div class="card-body">
                                <h6>LoggerService Logs:</h6>
                                <div class="bg-dark text-white p-3 rounded">
                                    @foreach (var log in ViewBag.ScopedLogs)
                                    {
                                        <p class="mb-1 font-monospace small">@log</p>
                                    }
                                </div>
                                <p class="mb-0 mt-2 text-muted">
                                    <small>
                                        <i class="fas fa-check"></i> All logs in this request have the same instance ID because 
                                        Scoped services maintain the same instance within a single request. Each new page load 
                                        will show a different instance ID.
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Transient Lifetime -->
                    <div class="mb-4">
                        <h4 class="text-danger">
                            <i class="fas fa-sync"></i> Transient Service
                        </h4>
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="alert alert-primary">
                                            <h6>TimeService Instance 1:</h6>
                                            <code>@ViewBag.TransientId1</code>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="alert alert-primary">
                                            <h6>TimeService Instance 2:</h6>
                                            <code>@ViewBag.TransientId2</code>
                                        </div>
                                    </div>
                                </div>
                                <p class="mb-0 text-muted">
                                    <small>
                                        <i class="fas fa-check"></i> These two GUIDs are different because Transient services 
                                        create a new instance every time they are injected. Even within the same request, 
                                        each injection gets a brand new instance.
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Comparison Table -->
                    <div class="mb-4">
                        <h4 class="text-primary">
                            <i class="fas fa-table"></i> Lifetime Comparison
                        </h4>
                        <table class="table table-bordered table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Lifetime</th>
                                    <th>When Created</th>
                                    <th>When Disposed</th>
                                    <th>Use Case</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Transient</strong></td>
                                    <td>Every time service is requested</td>
                                    <td>After request completes</td>
                                    <td>Lightweight, stateless services</td>
                                </tr>
                                <tr>
                                    <td><strong>Scoped</strong></td>
                                    <td>Once per request</td>
                                    <td>After request completes</td>
                                    <td>Database contexts, per-request operations</td>
                                </tr>
                                <tr>
                                    <td><strong>Singleton</strong></td>
                                    <td>First time service is requested</td>
                                    <td>Application shutdown</td>
                                    <td>Configuration, caching, shared state</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Code Example -->
                    <div class="mb-4">
                        <h4 class="text-info">
                            <i class="fas fa-code"></i> Registration Code (Program.cs)
                        </h4>
                        <pre class="bg-dark text-white p-3 rounded"><code>// Transient
builder.Services.AddTransient&lt;ITimeService, TimeService&gt;();

// Scoped
builder.Services.AddScoped&lt;ILoggerService, LoggerService&gt;();

// Singleton
builder.Services.AddSingleton&lt;IDataService, DataService&gt;();
builder.Services.AddSingleton&lt;IGreetingService, GreetingService&gt;();</code></pre>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to Main Demo
                    </a>
                    <button onclick="location.reload()" class="btn btn-warning">
                        <i class="fas fa-redo"></i> Refresh to See New Instances
                    </button>
                    <span class="text-muted float-end">
                        Lab No.: 19 | Samir Paudel | 114-079/D
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
