@{
    ViewData["Title"] = "Dependency Injection Demo";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="fas fa-syringe"></i> Dependency Injection Demonstration
                    </h2>
                </div>
                <div class="card-body">
                    <!-- Greeting Service (Singleton) -->
                    <div class="mb-4">
                        <h4 class="text-primary">
                            <i class="fas fa-comment"></i> Greeting Service (Singleton)
                        </h4>
                        <div class="alert alert-info">
                            <p class="mb-1"><strong>@ViewBag.TimeBasedGreeting</strong></p>
                            <p class="mb-0">@ViewBag.Greeting</p>
                        </div>
                    </div>

                    <!-- Data Service (Singleton) -->
                    <div class="mb-4">
                        <h4 class="text-primary">
                            <i class="fas fa-database"></i> Data Service (Singleton)
                        </h4>
                        <p><strong>Total Students:</strong> @ViewBag.StudentCount</p>
                        <p><strong>@ViewBag.ServiceCreated</strong></p>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Student Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int index = 1; }
                                    @foreach (var student in ViewBag.Students)
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td>@student</td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Time Service (Transient) -->
                    <div class="mb-4">
                        <h4 class="text-primary">
                            <i class="fas fa-clock"></i> Time Service (Transient)
                        </h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h6>Current Date:</h6>
                                        <p class="lead">@ViewBag.CurrentDate</p>
                                        <h6>Current Time:</h6>
                                        <p class="lead">@ViewBag.CurrentTime</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6>Instance IDs (Demonstrates Transient):</h6>
                                        <p class="mb-1">
                                            <strong>TimeService1:</strong><br />
                                            <code>@ViewBag.TimeService1Id</code>
                                        </p>
                                        <p class="mb-0">
                                            <strong>TimeService2:</strong><br />
                                            <code>@ViewBag.TimeService2Id</code>
                                        </p>
                                        <small class="text-muted">
                                            Different IDs = Different instances
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Logger Service (Scoped) -->
                    <div class="mb-4">
                        <h4 class="text-primary">
                            <i class="fas fa-file-alt"></i> Logger Service (Scoped)
                        </h4>
                        <div class="card">
                            <div class="card-body bg-dark text-white">
                                <h6>Request Logs:</h6>
                                @foreach (var log in ViewBag.Logs)
                                {
                                    <p class="mb-1 font-monospace small">@log</p>
                                }
                            </div>
                        </div>
                        <small class="text-muted">
                            Scoped services maintain same instance throughout a single request
                        </small>
                    </div>

                    <!-- Explanation -->
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-info-circle"></i> Service Lifetimes Explained:</h5>
                        <ul class="mb-0">
                            <li><strong>Transient:</strong> New instance every time it's injected</li>
                            <li><strong>Scoped:</strong> Same instance within a request, new instance for each request</li>
                            <li><strong>Singleton:</strong> Single instance throughout application lifetime</li>
                        </ul>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-action="Lifetimes" class="btn btn-info">
                        <i class="fas fa-sync"></i> View Service Lifetimes Demo
                    </a>
                    <span class="text-muted float-end">
                        Lab No.: 19 | Samir Paudel | 114-079/D
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
