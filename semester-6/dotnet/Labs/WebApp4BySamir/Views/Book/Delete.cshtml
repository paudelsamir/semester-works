@model WebApp4BySamir.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h3>Delete Book</h3>
        </div>
        <div class="card-body">
            <h5 class="text-danger">Are you sure you want to delete this book?</h5>
            
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@Model.Author</dd>

                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@Model.ISBN</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">Rs. @Model.Price.ToString("N2")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="BookId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
