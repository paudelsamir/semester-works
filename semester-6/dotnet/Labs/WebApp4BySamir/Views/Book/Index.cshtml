@model IEnumerable<WebApp4BySamir.Models.Book>

@{
    ViewData["Title"] = "Book List";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3>Book Management - Entity Framework Core (Code First)</h3>
            <p class="mb-0"><strong>Name:</strong> Samir Paudel | <strong>Roll No:</strong> 114-079/D</p>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <p>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add New Book
                </a>
            </p>

            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>ISBN</th>
                        <th>Price</th>
                        <th>Genre</th>
                        <th>Published</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BookId</td>
                                <td>@item.Title</td>
                                <td>@item.Author</td>
                                <td>@item.ISBN</td>
                                <td>Rs. @item.Price.ToString("N2")</td>
                                <td>@item.Genre</td>
                                <td>@item.PublishedDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No books found. Add one!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
