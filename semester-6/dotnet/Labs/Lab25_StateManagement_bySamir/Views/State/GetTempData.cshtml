@{
    ViewData["Title"] = "TempData Demo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4>📬 TempData (After Redirect)</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-success">
                        <strong>✓ @ViewBag.SuccessMsg</strong>
                    </div>
                    
                    <div class="alert alert-info">
                        <strong>ℹ️ @ViewBag.InfoMsg</strong>
                    </div>

                    <p><small>TempData is automatically deleted after this view.</small></p>
                    
                    <a href="/State/Index" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
