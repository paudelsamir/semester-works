@{
    ViewData["Title"] = "Session State";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>📌 Session Data</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info">@ViewBag.Message</div>
                    }

                    @if (ViewBag.SessionData != null)
                    {
                        <table class="table">
                            <tr>
                                <td><strong>User Name:</strong></td>
                                <td>@ViewBag.SessionData.UserName</td>
                            </tr>
                            <tr>
                                <td><strong>Roll No:</strong></td>
                                <td>@ViewBag.SessionData.RollNo</td>
                            </tr>
                            <tr>
                                <td><strong>Section:</strong></td>
                                <td>@ViewBag.SessionData.Section</td>
                            </tr>
                        </table>
                    }

                    <a href="/State/Index" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
