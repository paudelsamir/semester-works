@model MoodBoard.Models.Mood

@{
    ViewData["Title"] = "Delete Mood";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card @(ViewData["IsDarkMode"] == "true" ? "bg-dark text-white" : "")">
            <div class="card-body">
                <h4 class="card-title text-center mb-4">Delete Mood Entry</h4>
                <div class="alert alert-danger">
                    <h5>Are you sure you want to delete this mood entry?</h5>
                </div>
                <dl class="row">
                    <dt class="col-sm-3">Feeling</dt>
                    <dd class="col-sm-9">@Model.Feeling</dd>

                    <dt class="col-sm-3">Quote</dt>
                    <dd class="col-sm-9">@Model.Quote</dd>

                    <dt class="col-sm-3">Created At</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                </dl>

                <form asp-action="Delete" class="text-center">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </form>
            </div>
        </div>
    </div>
</div>